# Шаблон локального окружения. НЕ коммитить настоящие ключи — файл .env в .gitignore.
#
# Контракт STT-веток транскрибации (см. skills/wiki-transcript-private и
# skills/wiki-transcript-common). Приоритет источников: реальная переменная
# окружения → локальный .env → дефолт. Настоящие значения держите вне репозитория.
#
# Ветки разделены по чувствительности данных, а не по удобству:
#   приватная — личные записи, провайдер только прямой/self-hosted, агрегаторы запрещены;
#   общая     — неприватный публичный контент, мультитенантный агрегатор допустим.

# ── Приватная ветка: голосовые, приватные встречи, диктовка ──
STT_PRIVATE_URL=
STT_PRIVATE_MODEL=
STT_PRIVATE_KEY=

# ── Общая ветка: видео, подкасты, эфиры, рилы, лекции ──
STT_COMMON_URL=
STT_COMMON_MODEL=
STT_COMMON_KEY=

# Язык передаётся явно: автоопределение на коротких клипах ошибается.
STT_LANG=ru
