# Шаблон локального окружения. НЕ коммитить настоящие ключи — файл .env в .gitignore.
#
# ┌─ КУДА КЛАСТЬ ──────────────────────────────────────────────────────────────┐
# │ Файл `.env` в КОРНЕ этого vault'а. Он в .gitignore и в репозиторий не попадёт.│
# │ Другой путь можно указать в переменной STT_ENV_FILE.                        │
# └───────────────────────────────────────────────────────────────────────────┘
#
# ФОРМАТ: `KEY=значение`, по строке, без export, кавычки не нужны; `#` — комментарий.
#
# Владельцу не обязательно создавать файл руками: достаточно продиктовать агенту
# endpoint, модель и токен — агент запишет их сюда (в репозиторий они не попадут).
#
# Приоритет источников: реальное окружение → этот файл. ДЕФОЛТОВ В КОДЕ НЕТ:
# отсутствие обязательного значения — явная ошибка (fail-loud), а не подмена.
#
# ── Приватная ветка STT: личные записи владельца (голосовые, приватные встречи, диктовка) ──
# Провайдер ТОЛЬКО прямой или self-hosted: для персональных данных агрегаторы запрещены.
# Скрипт: stt-private <файл> <выходной.txt>
STT_PRIVATE_URL=
STT_PRIVATE_MODEL=
STT_PRIVATE_KEY=

# ── Публичная ветка STT: неприватный публичный контент (видео, рилы, подкасты, эфиры) ──
# Агрегатор допустим, модель может быть дешёвой.
# Скрипт: stt-public <ссылка|файл> <выходной.txt>
# Устаревшее имя переменных STT_COMMON_* ещё принимается как алиас.
STT_PUBLIC_URL=
STT_PUBLIC_MODEL=
STT_PUBLIC_KEY=

# Язык передаётся явно: автоопределение на коротких клипах ошибается.
STT_LANG=ru

# ── OCR (см. skills/wiki-ocr) ──
# Ступени 1–2: локальный tesseract, затем облачный vision — только по согласию владельца.
OCR_LANGS=rus+eng
OCR_CLOUD_URL=
OCR_CLOUD_MODEL=
OCR_CLOUD_KEY=
