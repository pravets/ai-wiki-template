# Obsidian workspace state (session-specific, not source)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Plugin binaries (install from Obsidian community catalog; see README)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Syncthing conflict copies
*.sync-conflict-*

# Локальные секреты: .env никогда не коммитить.
# Шаблон контракта (без значений) — .env.example, он коммитится.
.env
.env.*
!.env.example

# Node/tooling
node_modules/

# Python bytecode (helpers are run directly, caches are not source)
__pycache__/
*.pyc

# Сырьё в репозиторий не коммитим — только разобранный материал (правило 9 контракта).
# Репозиторий заметок остаётся текстовым: диффится, переносится, не пухнет.
# Осознанное исключение — только явно: git add -f <файл>.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.m4a
*.wav
*.ogg
*.flac
*.opus
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.heic
*.tif
*.tiff
*.bmp
*.pdf
*.zip
*.7z
*.tar
*.gz